#!/usr/bin/env bash

# tmux session manager
#
# mux          fzf picker to manage and attach to sessions
# mux <name>   attach or create+attach by name
#
# fzf picker:
#   enter   attach (outside tmux) / print instruction (inside)
#   ctrl-n  create new session (uses query as name)
#   ctrl-k  kill session (blocked for current)
#   ctrl-r  rename session
#   ctrl-x  detach other clients
#   preview shows window list + active pane content
#   re-opens after kill/rename/detach/create; closes after attach

if [ "$#" -gt 0 ]; then
    if [ -n "$TMUX" ]; then
        tmux new-session -s "$1" -d
        tmux switch-client -t "$1"
    else
        tmux new-session -A -s "$1"
    fi
    exit
fi

[ -n "$TMUX" ] && current_session="$(tmux display-message -p '#{session_name}')"
# One row per pane, each carrying its session's formats, so a single tmux call
# gives both the pane counts and the session details. Asking tmux per session
# instead would cost four processes per session. Every session has at least one
# pane, so nothing is missed.
sessions () {
    tmux list-panes -a -F $'#{session_last_attached}\t#{session_name}\t#{session_windows}\t#{session_attached}' 2> /dev/null \
        | sort --numeric-sort --reverse \
        | awk -F'\t' -v cur="$current_session" '
            # Sorted by last attached, so first sighting orders the sessions.
            !seen[$2]++ { order[++total] = $2; windows[$2] = $3; attached[$2] = $4 }
            { panes[$2]++ }
            # Most recently used other session first, so enter switches away.
            END {
                for (i = 1; i <= total; i++) {
                    name = order[i]
                    line = name ": " windows[name] " windows, " panes[name] " panes" (attached[name] > 0 ? " (attached)" : "")
                    if (name == cur) { held = line; continue }
                    others[++other_total] = line
                }
                if (other_total) print others[1]
                if (held) print held
                for (i = 2; i <= other_total; i++) print others[i]
            }
        '
}

# shellcheck disable=SC2016  # Content in single quotes is not trying to use Bash processing.
while true; do
    out="$(
        sessions \
            | fzf --ansi --reverse --no-sort --delimiter=':' --nth=1 \
                --query="$selected" --print-query \
                --expect=ctrl-n,ctrl-k,ctrl-r,ctrl-x \
                --header='enter=attach / ctrl-n=new / ctrl-k=kill / ctrl-r=rename / ctrl-x=detach others' \
                --preview='
                    name={1}; name=${name%:};
                    tmux list-windows -t "$name" -F "  #{window_index}: #{window_name}#{?window_active, (*),} #{pane_current_command}" 2> /dev/null;
                    echo;
                    tmux capture-pane -t "$name" -p -e 2> /dev/null
                ' \
                --preview-window=down:50%:noinfo
    )" || true
    selected="$(head -1 <<< "$out")"
    key="$(head -2 <<< "$out" | tail -1)"
    session="$(sed '1,2d' <<< "$out" | cut -d: -f1)"
    # No key pressed and no session selected = user cancelled
    [ -z "$key" ] && [ -z "$session" ] && break
    if [ "$key" = 'ctrl-n' ]; then
        name="${selected:-main}"
        if [ -n "$TMUX" ]; then
            tmux new-session -s "$name" -d
            tmux switch-client -t "$name"
        else
            tmux new-session -s "$name"
        fi
        break
    fi
    [ -z "$session" ] && continue
    if [ "$key" = 'ctrl-k' ]; then
        if [ "$session" = "$current_session" ]; then
            echo 'Cannot kill current session'
        else
            tmux kill-session -t "$session"
        fi
    elif [ "$key" = 'ctrl-r' ]; then
        read -r -p "Rename '$session' to: " new_name
        [ -n "$new_name" ] && tmux rename-session -t "$session" "$new_name"
    elif [ "$key" = 'ctrl-x' ]; then
        tmux detach-client -s "$session" -a
    else
        if [ -n "$TMUX" ]; then
            tmux switch-client -t "$session"
        else
            tmux attach-session -t "$session"
        fi
        break
    fi
done
