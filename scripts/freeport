#!/usr/bin/env python3

# Print a free TCP port from the ephemeral range (49152-65535 on macOS).
#
# The kernel picks the port, so it is free at the moment of binding. Note the
# small possible window for a race condition: it is released again before the
# caller gets to bind it.

import socket

with socket.socket() as sock:
    sock.bind(("", 0))
    print(sock.getsockname()[1])
