Restore 3.7 pane layout behavior:
- Make `select-layout -E` also count child cells that are splits themselves.
  3.8 counts only leaf panes, so spreading e.g. `[A | B] / C` does nothing,
  and a split with some nested children gets the wrong sizes.
- Give a closed pane's space to the previous neighbor (the next one if it was first), not the next one.

diff --git a/layout.c b/layout.c
--- a/layout.c
+++ b/layout.c
@@ -673,12 +673,12 @@ struct layout_cell *
 layout_cell_get_neighbour(struct layout_cell *lc)
 {
 	struct layout_cell	*lcother, *lcparent = lc->parent;
-	int			 direction = 1;
+	int			 direction = 0;
 
 	if (lcparent == NULL)
 		return (NULL);
 
-	if (lc == TAILQ_LAST(&lcparent->cells, layout_cells))
+	if (lc == TAILQ_FIRST(&lcparent->cells))
 		direction = !direction;
 
 	lcother = layout_cell_get_neighbour_dir(lc, direction);
@@ -1558,7 +1558,7 @@ layout_spread_cell(struct window *w, struct layout_cell *parent)
 
 	number = 0;
 	TAILQ_FOREACH (lc, &parent->cells, entry)
-		if (layout_cell_is_tiled(lc))
+		if (layout_cell_is_tiled(lc) || layout_cell_has_tiled_child(lc))
 			number++;
 	if (number <= 1)
 		return (0);
@@ -1587,7 +1587,7 @@ layout_spread_cell(struct window *w, struct layout_cell *parent)
 
 	changed = 0;
 	TAILQ_FOREACH (lc, &parent->cells, entry) {
-		if (!layout_cell_is_tiled(lc))
+		if (!layout_cell_is_tiled(lc) && !layout_cell_has_tiled_child(lc))
 			continue;
 		change = 0;
 		if (parent->type == LAYOUT_LEFTRIGHT) {
