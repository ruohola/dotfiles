{
  "extensions.updateCheck": "weekly",
  "coc.source.dictionary.filetypes": ["markdown"],
  "coc.source.file.ignoreHidden": false,
  "suggest.invalidInsertCharacters": [],
  "suggest.noselect": false,
  "java.jdt.ls.java.home": "~/.sdkman/candidates/java/current",
  "python.linting.ruffEnabled": true,
  "python.linting.ruffPath": "${env:HOMEBREW_PREFIX}/bin/ruff",
  "python.formatting.provider": "ruff",
  "python.formatting.ruffPath": "${env:HOMEBREW_PREFIX}/bin/ruff",
  "pyright.organizeimports.provider": "ruff",
  // Managed via `$ rustup component add rust-analyzer` instead.
  "rust-analyzer.updates.prompt": "neverDownload",
  "languageserver": {
    "githubactions": {
      "command": "actions-languageserver",
      "args": ["--stdio"],
      "filetypes": ["githubactions"]
    },
    "haskell": {
      "command": "haskell-language-server-wrapper",
      "args": [
        "--lsp"
      ],
      "rootPatterns": [
        "*.cabal",
        "stack.yaml",
        "cabal.project",
        "package.yaml"
      ],
      "filetypes": [
        "hs",
        "lhs",
        "haskell"
      ],
      "initializationOptions": {
        "languageServerHaskell": {}
      }
    },
    "terraform": {
      "command": "terraform-ls",
      "args": ["serve"],
      "filetypes": ["terraform"]
    },
    "zk": {
      "command": "zk",
      "args": ["lsp"],
      "trace.server": "messages",
      "filetypes": ["markdown"]
    }
  },
  "json.schemaDownload.trustedDomains": {
    "https://json.schemastore.org": true,
    "https://www.schemastore.org": true,
    "*": false
  }
}
