function! s:SolarizedHighlights() abort
    highlight Comment term=NONE ctermfg=10

    " Make solarized8 terminal and gui cursor the same color.
    execute 'highlight Cursor ctermfg=15 ctermbg=4'
        \ . ' guifg=' . g:terminal_ansi_colors[0]
        \ . ' guibg=' . g:terminal_ansi_colors[12]

    " Remove light blue background from matching parenthesis.
    highlight MatchParen guibg=NONE ctermbg=NONE

    " Keep link text magenta and spelling errors purple in both backgrounds.
    execute 'highlight Underlined ctermfg=5 guifg=' . g:terminal_ansi_colors[5]
    if &background ==# 'light'
        execute 'highlight SpellBad ctermfg=13 guifg=' . g:terminal_ansi_colors[13]
    endif

    " Distinguish LanguageTool grammar errors from native spelling ones.
    execute 'highlight GrammarousError gui=undercurl cterm=undercurl'
        \ . ' guifg=NONE ctermfg=NONE ctermul=9'
        \ . ' guisp=' . g:terminal_ansi_colors[9]

    " Make Markdown inline `code` spans green instead of the default string color.
    execute 'highlight markdownCode ctermfg=2 guifg=' . g:terminal_ansi_colors[2]

    " Mark coc.nvim symbol usages with a violet background, keeping syntax colors.
    execute 'highlight CocHighlightText gui=NONE cterm=NONE'
        \ . ' guibg=' . (&background ==# 'dark' ? '#4a4765' : '#cac5e9')
endfunction

" Changing background reloads the colorscheme, so reapply our overrides.
augroup SolarizedHighlights
    autocmd!
    autocmd ColorScheme solarized8 call <SID>SolarizedHighlights()
augroup END

" Set these only when vim starts, not when sourcing vimrc.
if !exists('g:notfirstopen')
    let g:notfirstopen=1

    set termguicolors
    set background=dark

    let g:solarized_italics=0
    colorscheme solarized8  " Messes up Mundo if loaded again.

    if has('gui_running')
        set lines=40 columns=120  " Initial window size.
        " Changing font moves the window.
        set guifont=MenloNFM-Regular:h16
    endif

    syntax enable

    " Make sure that the temp file locations exists, readable only by us.
    for s:folder in [&undodir, &backupdir, &directory]
        call mkdir(s:folder, 'p', str2nr('700', 8))
    endfor
endif

if has('gui_running')
    " GUI specific settings.
    set guioptions=
    " Cursor is a vertical bar in insert mode and a block in normal mode.
    set guicursor+=a:blinkon0
    set guicursor+=i-ci:ver20-blinkon0
else
    " Terminal specific settings.
    set mouse=a
    if $TERM =~ '\(xterm\|tmux\)-256color'
        set ttymouse=sgr
        let &t_SI = "\e[6 q"
        let &t_EI = "\e[2 q"
        let &t_SR = "\e[4 q"
        " Fix terminal title becoming `titleold` instead of the actual
        " previous title when closing Vim in tmux.
        let &t_ST = "\e[22;2t"
        let &t_RT = "\e[23;2t"
        " Enable undercurl support inside iTerm>tmux>Vim.
        let &t_Cs = "\e[4:3m"
        let &t_Ce = "\e[4:0m"
        let &t_8u = "\e[58;2;%lu;%lu;%lum"
    endif
endif

" Visuals
