function! s:insert_completion() abort
    call coc#config('suggest', {'insertMode': 'insert'})
    call timer_start(1, {-> coc#config('suggest', {'insertMode': 'replace'})})
    return coc#pum#confirm()
endfunction

inoremap <silent> <expr> <CR>
    \ exists('*coc#pum#visible') && coc#pum#visible()
    \     ? <SID>insert_completion()
    \     : pumvisible()
    \         ? "\<C-y>"
    \         : "\<C-g>u\<CR>"

inoremap <silent> <expr> <TAB>
    \ exists('*coc#pum#visible') && coc#pum#visible()
    \     ? coc#pum#confirm()
    \     : pumvisible()
