set spelllang=en_us  " Finnish is opted into per buffer, see the Markdown ftplugin.
set fileformats=unix,dos
set fileencodings=ucs-bom,utf-8,default,latin1
set encoding=utf-8
scriptencoding utf-8

" Vim file locations.
let s:vim_dir = $HOME . '/.vim'
let s:plugins_dir = s:vim_dir . '/plugins'
let s:spell_dir = s:vim_dir . '/spell'
let s:patches_dir = s:vim_dir . '/patches'
let s:data_dir = $HOME . '/.local/share/vim'
let s:state_dir = $HOME . '/.local/state/vim'
" `zg` adds a word to the first entry, `2zg` to the second.
let &spellfile = s:spell_dir . '/en.utf-8.add'
    \ . ',' . s:spell_dir . '/fi.utf-8.add'
" `vim -i NONE` starts an anonymous session (no .viminfo or undo files).
" Swap files and the default `writebackup` are still used for safety.
let g:anonymous = &viminfofile ==# 'NONE'
if empty(&viminfofile)
    " Guard allows this to be overriden by e.g. `vim -i NONE`.
    let &viminfofile = s:state_dir . '/.viminfo'
endif
let &undodir = s:data_dir . '/undo//'
let &backupdir = s:state_dir . '/backup//'
let &directory = s:state_dir . '/swap//'
let g:netrw_dirhistmax=0



