" Inspiration from: https://github.com/dhleong/dots/blob/master/.vim/init/terminal.vim
function! RunCommandInSplitTerm(command, ...) abort
    " Defaults to 0.3 (30%) split if a second argument is not passed.
    noautocmd write
    let winSize = float2nr(get(a:, 1, 0.3) * winheight(0))
    let mainBuf = bufnr('%')
    let termBufNr = get(b:, '_run_term', -1)
    let termWinNr = bufwinnr(termBufNr)

    if termWinNr == -1
        execute 'below split | resize ' . winSize
        if termBufNr == -1 || bufexists(termBufNr) == 0
            let termBufNr = term_start(&shell, {
                        \ 'curwin': 1,
                        \ 'term_finish': 'close',
                        \ })
            call setbufvar(mainBuf, '_run_term', termBufNr)
        else
            execute 'buffer' . termBufNr
        endif
    else
        execute termWinNr . 'wincmd w'
    endif

    let mainWin = bufwinnr(mainBuf)
    call term_sendkeys(termBufNr, a:command . "\<CR>")
    execute "normal \<C-W>p"
endfunction


function! RunCommandInPopupTerm(command_list) abort
    noautocmd write
    let buf = term_start(a:command_list, #{hidden: 1, term_finish: 'close'})
    let winid = popup_create(buf, #{minwidth: 999, minheight: 999})
endfunction


let s:_delta_pager = 'delta --paging=always --pager="less --clear-screen"'

function! s:ShowGitHistoryForFile() abort
    let file = shellescape(expand('%:p'))
    let dir = shellescape(expand('%:p:h'))
    let cmd = printf(
        \ '{ if ! git -C %s --no-pager diff --quiet HEAD -- %s 2>/dev/null; then'
        \ . ' printf "commit [local changes]\n\n";'
        \ . ' git -C %s --no-pager diff --color=always HEAD -- %s; printf "\n"; fi;'
        \ . ' git -C %s --no-pager log --color=always --format=fuller --patch -- %s;'
        \ . ' } | %s',
        \ dir, file, dir, file, dir, file, s:_delta_pager)
    call RunCommandInPopupTerm(['sh', '-c', cmd])
endfunction


function! s:ShowGitHistoryForSelection() abort
    let file = shellescape(expand('%:p'))
    let dir = shellescape(expand('%:p:h'))
    let start = line("'<")
    let end = line("'>")
    " If line 1 is the ephemeral commit's header, swap it (and its metadata)
    " for a plain "commit [local changes]" banner up to the first diff line.
    let awk = 'NR==1 && index($0, r) {s=1; print "commit [local changes]\n"; next} /diff --git/ {s=0} !s'
    " Stash the working copy into an ephemeral commit so `git log -L` traces
    " the selection from any local changes.
    let cmd = printf(
        \ 'stash=$(git -C %s stash create);'
        \ . ' if [ -n "$stash" ]; then'
        \ . '     tree=$(git -C %s rev-parse "$stash^{tree}");'
        \ . '     ref=$(git -C %s commit-tree "$tree" -p HEAD -m " ");'
        \ . ' else ref=HEAD; fi;'
        \ . ' git -C %s --no-pager log --color=always --format=fuller --patch -L %d,%d:%s "$ref"'
        \ . ' | awk -v r="$ref" ''%s'' | %s',
        \ dir, dir, dir, dir, start, end, file, awk, s:_delta_pager)
    call RunCommandInPopupTerm(['sh', '-c', cmd])
endfunction


" Copy the current file's path, relative to the Git worktree (or submodule) root
" when inside one, otherwise absolute with `~` in place of the home directory.
function! s:CopyFilePath() abort
    if empty(expand('%'))
        echo 'No file name'
        return
    endif
    let path = trim(system('repopath ' . shellescape(expand('%:p'))))
    if v:shell_error != 0
        echo path
        return
    endif
    let @* = path
    echo @*
endfunction


" Open a scratch window with the on-disk contents of the current file and diff the
" two, or close that window again when one is already open.
" https://vimhelp.org/diff.txt.html#%3ADiffOrig
function! s:DiffOrig() abort
    if exists('t:diff_orig_buf')
        let l:buf = t:diff_orig_buf
        unlet t:diff_orig_buf
        " The buffer is already gone when the window was closed by hand.
        if bufexists(l:buf)
            execute 'bwipeout' l:buf
        endif
        diffoff!
        return
    endif

    let l:filetype = &filetype
    diffthis
    vertical new
    let t:diff_orig_buf = bufnr('%')
    setlocal buftype=nofile bufhidden=wipe nobuflisted
    read ++edit #
    0delete _
    " Give the scratch buffer the same highlighting as the original.
    let &l:filetype = l:filetype
    diffthis
    wincmd p
endfunction


" Insert blank lines before current line.
function! s:BlankUp(count) abort
    norm! mq
    for i in range(a:count)
        execute "norm! O\<Esc>0\"_D"
    endfor
    norm! `q
endfunction


" Insert blank lines after current line.
function! s:BlankDown(count) abort
    norm! mq
    for i in range(a:count)
        execute "norm! o\<Esc>0\"_D"
    endfor
    norm! `q
endfunction


" Redirect command's output to the current line.
function! RED(command)
    redir => output
    silent execute a:command
    redir END
    let @z = substitute(output, '^\n', '', '')
    put z
    return ''
endfunction


function! ChangeReg(x) abort
  call feedkeys("q:ilet @" . a:x . " = \<c-r>\<c-r>=string(@" . a:x . ")\<cr>\<esc>0f'", 'n')
endfunction


" Uninstall coc extensions that are no longer in `g:coc_global_extensions`.
function! s:CocClean() abort
    if !coc#rpc#ready()
        echo 'Coc is not running'
        return
    endif
    let l:installed = map(
        \ filter(CocAction('extensionStats'), {_, v -> !v.isLocal}),
        \ {_, v -> v.id})
    let l:extra = filter(l:installed, {_, v -> index(g:coc_global_extensions, v) < 0})
    if !empty(l:extra)
        execute 'CocUninstall ' . join(l:extra)
    endif
endfunction


" Avoid a statusline message when saving a file, and also avoid the `:w` itself
" lingering around in the command line. Does the write here and replaces the
" command with `:ec`, which prints an empty message, clearing the command line.
" Failed writes still report their error.
function! s:SilentWrite() abort
    if getcmdtype() ==# ':' && getcmdline() ==# 'w'
        call setcmdline('ec')
        silent write
    endif
endfunction


" Settings that are ran after vim -c '<command>' is exeuted, so after git mergetool has finished its setup.
function! NewPostLaunchSettings(pathToSpellFolder) abort
    let context = {'pathToSpellFolder': a:pathToSpellFolder}

    function! context.f()
        if !&diff
            " Rebuild the spell files whose word list has changed, but only if
            " not using Vim as Git mergetool. This avoids an annoying error when
            " a word list has conflict markers which result in a syntax error.
            " A `*.add` is a personal word list `zg` appends to, compiling to
            " `<name>.add.spl`. A `*.wordlist` is a whole language (Vim has no
            " Finnish one), compiling to `<name>.<encoding>.spl`.
            "
            " `mkspellmem`'s default recompresses the word tree every 2 MB, which
            " for a multi-million word list means constant recompression of an
            " ever bigger tree. This setting decreases the build from 5 min to 10 s.
            set mkspellmem=2000000,50000,2000
            for source in glob(self.pathToSpellFolder . '/*.add', 1, 1)
                        \ + glob(self.pathToSpellFolder . '/*.wordlist', 1, 1)
                let target = source =~# '\.add$'
                    \ ? source . '.spl'
                    \ : substitute(source, '\.wordlist$', '.' . &encoding . '.spl', '')
                if filereadable(source)
                        \ && (!filereadable(target) || getftime(source) > getftime(target))
                    silent execute 'mkspell! ' . fnameescape(target) . ' ' . fnameescape(source)
                endif
            endfor

            " Enable coc.nvim only when not running vimdiff, so it doesn't complain about conflict markers.
            " Also not in anonymous sessions, as it keeps its own history (e.g. `CocList mru`).
            if !g:anonymous
                CocStart
            endif

            set splitright  " Open splits to the right
            set splitbelow  " Open splits to the bottom
        else
            syntax off

            " Patches in: https://github.com/git/git/commit/f3d7623a13566048c4a48b9db6bb09765588a735
            set nosplitright
            set nosplitbelow
        endif
    endfunction

    return context
endfunction



" ============= AUTOCMD =============

" Source vimrc when it's saved.
augroup ReloadVimrc
    autocmd!
    autocmd BufWritePost *vimrc so $MYVIMRC
augroup END


" Open help windows in a new tab.
augroup HelpOpen
    autocmd!
    autocmd BufWinEnter *.txt if &buftype ==? 'help'
                    \|execute "normal \<C-W>T"
                \|endif
augroup END


" Clear trailing whitespace when saving vimrc.
augroup TrimWhitespace
    autocmd!
    autocmd BufWritePre *vimrc :%s/\s\+$//e
augroup END


" Restore the last cursor position when opening a file.
" https://vimhelp.org/usr_05.txt.html#last-position-jump
augroup RestoreCursorPosition
    autocmd!
    autocmd BufReadPost *
      \ if line("'\"") >= 1 && line("'\"") <= line("$") && &ft !~# 'commit'
      \      && index(['xxd', 'gitrebase'], &ft) == -1 && !&diff
      \ |   exe "normal! g`\""
      \ | endif
augroup END


" Automatically activate some filetypes.
augroup FileTypes
    autocmd!
    autocmd BufRead,BufNewFile .bashrc,.bash_profile set filetype=bash
    autocmd BufRead,BufNewFile * if getline(1) == '#!/bin/bash' || getline(1) == '#!/usr/bin/env bash' || getline(1) == '# shellcheck shell=bash' | set filetype=bash | endif
    autocmd BufRead,BufNewFile Dockerfile* set filetype=dockerfile
    autocmd BufRead,BufNewFile .gitconfig* set filetype=gitconfig
    " Compound filetype, Vim sources both and coc derives the LSP language ID from
    " the part before the dot, disabling coc-yaml.
    autocmd BufRead,BufNewFile */.github/workflows/*.yml,*/.github/workflows/*.yaml set filetype=githubactions.yaml
    autocmd BufRead,BufNewFile *.jsx set filetype=javascriptreact
    autocmd BufRead,BufNewFile *.tfstate set filetype=json
    autocmd BufRead,BufNewFile coc-settings.json set filetype=jsonc
    autocmd BufRead,BufNewFile Brewfile* set filetype=ruby
    autocmd BufRead,BufNewFile .env* set filetype=sh | let b:coc_enabled = 0
    autocmd BufRead,BufNewFile env,bookmarks set filetype=sh
    autocmd BufRead,BufNewFile *.tsx set filetype=typescriptreact
augroup END


" Avoid the `trail` `listchar` from annoyingly showing in insert mode when typing.
augroup TrailInsert
  autocmd!
  autocmd InsertEnter * set listchars-=trail:·
  autocmd InsertLeave * set listchars+=trail:·
augroup END


" Write silently when saving with a plain `:w`.
augroup SilentWrite
    autocmd!
    autocmd CmdlineLeave : call <SID>SilentWrite()
augroup END


let s:post_launch_settings = NewPostLaunchSettings(s:spell_dir)

augroup SetPostLaunchSettings
  autocmd!
  autocmd VimEnter * call s:post_launch_settings.f()
augroup END
